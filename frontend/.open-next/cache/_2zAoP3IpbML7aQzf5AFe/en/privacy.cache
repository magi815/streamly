opularity\\\":\\\"Popularity\\\",\\\"rating\\\":\\\"Rating\\\",\\\"releaseDate\\\":\\\"Release Date\\\",\\\"period\\\":\\\"Period\\\",\\\"year1\\\":\\\"1 Year\\\",\\\"year2\\\":\\\"2 Years\\\",\\\"year5\\\":\\\"5 Years\\\",\\\"allTime\\\":\\\"All Time\\\"},\\\"common\\\":{\\\"loading\\\":\\\"Loading...\\\",\\\"error\\\":\\\"An error occurred\\\",\\\"retry\\\":\\\"Try Again\\\",\\\"noData\\\":\\\"No data available\\\",\\\"viewMore\\\":\\\"View More\\\",\\\"close\\\":\\\"Close\\\"},\\\"language\\\":{\\\"select\\\":\\\"Language\\\",\\\"ko\\\":\\\"한국어\\\",\\\"en\\\":\\\"English\\\",\\\"ja\\\":\\\"日本語\\\"},\\\"platform\\\":{\\\"netflix\\\":\\\"Netflix\\\",\\\"amazon_prime\\\":\\\"Amazon Prime Video\\\",\\\"disney_plus\\\":\\\"Disney+\\\",\\\"hulu\\\":\\\"Hulu\\\",\\\"max\\\":\\\"Max\\\",\\\"apple_tv_plus\\\":\\\"Apple TV+\\\",\\\"paramount_plus\\\":\\\"Paramount+\\\"},\\\"footer\\\":{\\\"copyright\\\":\\\"© 2026 WhatView. All rights reserved.\\\",\\\"privacy\\\":\\\"Privacy Policy\\\",\\\"terms\\\":\\\"Terms of Service\\\"},\\\"privacy\\\":{\\\"title\\\":\\\"Privacy Policy\\\",\\\"effectiveDate\\\":\\\"Effective Date: January 25, 2026\\\",\\\"section1\\\":{\\\"title\\\":\\\"1. Purpose of Processing Personal Information\\\",\\\"content\\\":\\\"WhatView (hereinafter referred to as the \\\\\\\"Service\\\\\\\") processes personal information for the following purposes.\\\",\\\"items\\\":[\\\"Service provision and operation\\\",\\\"Service usage statistics and analysis\\\",\\\"Service improvement and new service development\\\"]},\\\"section2\\\":{\\\"title\\\":\\\"2. Personal Information Collected\\\",\\\"content\\\":\\\"This Service is available without registration. We do not collect personal information separately.\\\",\\\"items\\\":[\\\"IP address\\\",\\\"Cookies\\\",\\\"Visit date and time\\\",\\\"Service usage records\\\",\\\"Device information (browser type, OS, etc.)\\\"]},\\\"section3\\\":{\\\"title\\\":\\\"3. Retention Period of Personal Information\\\",\\\"content\\\":\\\"Automatically collected information is used only for service usage statistics analysis and is immediately deleted after analysis.\\\"},\\\"section4\\\":{\\\"title\\\":\\\"4. Use of Cookies\\\",\\\"content\\\":\\\"This Service uses cookies to provide better service to users.\\\",\\\"items\\\":[\\\"What are cookies: Small text files sent to your browser by websites\\\",\\\"Purpose: To analyze access frequency and visit times to improve the service\\\",\\\"Cookie rejection: You can refuse to store cookies through browser settings\\\"]},\\\"section5\\\":{\\\"title\\\":\\\"5. Advertising Services\\\",\\\"content\\\":\\\"This Service may display advertisements through Google AdSense.\\\"},\\\"section6\\\":{\\\"title\\\":\\\"6. Privacy Officer\\\",\\\"content\\\":\\\"If you have any questions about personal information during service use, please contact us below.\\\",\\\"items\\\":[\\\"Service: WhatView\\\",\\\"Email: privacy@whatview.com\\\"]},\\\"section7\\\":{\\\"title\\\":\\\"7. Changes to Privacy Policy\\\",\\\"content\\\":\\\"This Privacy Policy is effective from January 25, 2026.\\\"}},\\\"terms\\\":{\\\"title\\\":\\\"Terms of Service\\\",\\\"effectiveDate\\\":\\\"Effective Date: January 25, 2026\\\",\\\"section1\\\":{\\\"title\\\":\\\"Article 1 (Purpose)\\\",\\\"content\\\":\\\"These terms and conditions govern the use of WhatView (hereinafter referred to as the \\\\\\\"Service\\\\\\\"), an OTT integrated search service.\\\"},\\\"section2\\\":{\\\"title\\\":\\\"Article 2 (Definitions)\\\",\\\"items\\\":[\\\"\\\\\\\"Service\\\\\\\" means the OTT platform integrated search, content information, and YouTube review integration services provided by WhatView.\\\",\\\"\\\\\\\"User\\\\\\\" means anyone who uses the Service under these terms.\\\",\\\"\\\\\\\"Content\\\\\\\" means movies, TV shows, and other information provided by the Service.\\\"]},\\\"section3\\\":{\\\"title\\\":\\\"Article 3 (Service Provision)\\\",\\\"content\\\":\\\"The Service provides the following features:\\\",\\\"items\\\":[\\\"OTT platform integrated search\\\",\\\"Movie and TV show information\\\",\\\"Available streaming platform information\\\",\\\"YouTube review video integration\\\",\\\"Trending and new release information\\\"]},\\\"section4\\\":{\\\"title\\\":\\\"Article 4 (Service Usage)\\\",\\\"items\\\":[\\\"The Service is free and available to anyone without registration.\\\",\\\"The Service aims to be available 24/7 but may be temporarily suspended for system maintenance.\\\",\\\"Service content may change as needed for operations.\\\"]},\\\"section5\\\":{\\\"title\\\":\\\"Article 5 (User Obligations)\\\",\\\"content\\\":\\\"Users must not engage in the following activities:\\\",\\\"items\\\":[\\\"Activities that interfere with normal service operation\\\",\\\"Unauthorized use or misuse of others' information\\\",\\\"Unauthorized reproduction or distribution of information obtained through the Service\\\",\\\"Unauthorized crawling or scraping of the Service\\\",\\\"Other activities that violate applicable laws\\\"]},\\\"section6\\\":{\\\"title\\\":\\\"Article 6 (Intellectual Property)\\\",\\\"items\\\":[\\\"Content information is provided through the TMDb (The Movie Database) API.\\\",\\\"Copyright of YouTube review videos belongs to respective video creators.\\\",\\\"Intellectual property rights for the Service's design, logo, and features belong to WhatView.\\\"]},\\\"section7\\\":{\\\"title\\\":\\\"Article 7 (Disclaimer)\\\",\\\"items\\\":[\\\"The Service does not guarantee the accuracy of content information.\\\",\\\"We are not responsible for damages caused by information obtained through the Service.\\\",\\\"We are not responsible for issues caused by external links.\\\",\\\"We are not responsible for service interruptions due to force majeure.\\\"]},\\\"section8\\\":{\\\"title\\\":\\\"Article 8 (Advertising)\\\",\\\"content\\\":\\\"The Service may display advertisements on the service screen for operational purposes.\\\"},\\\"secti