:{\"title\":\"6. Privacy Officer\",\"content\":\"If you have any questions about personal information during service use, please contact us below.\",\"items\":[\"Service: WhatView\",\"Email: privacy@whatview.com\"]},\"section7\":{\"title\":\"7. Changes to Privacy Policy\",\"content\":\"This Privacy Policy is effective from January 25, 2026.\"}},\"terms\":{\"title\":\"Terms of Service\",\"effectiveDate\":\"Effective Date: January 25, 2026\",\"section1\":{\"title\":\"Article 1 (Purpose)\",\"content\":\"These terms and conditions govern the use of WhatView (hereinafter referred to as the \\\"Service\\\"), an OTT integrated search service.\"},\"section2\":{\"title\":\"Article 2 (Definitions)\",\"items\":[\"\\\"Service\\\" means the OTT platform integrated search, content information, and YouTube review integration services provided by WhatView.\",\"\\\"User\\\" means anyone who uses the Service under these terms.\",\"\\\"Content\\\" means movies, TV shows, and other information provided by the Service.\"]},\"section3\":{\"title\":\"Article 3 (Service Provision)\",\"content\":\"The Service provides the following features:\",\"items\":[\"OTT platform integrated search\",\"Movie and TV show information\",\"Available streaming platform information\",\"YouTube review video integration\",\"Trending and new release information\"]},\"section4\":{\"title\":\"Article 4 (Service Usage)\",\"items\":[\"The Service is free and available to anyone without registration.\",\"The Service aims to be available 24/7 but may be temporarily suspended for system maintenance.\",\"Service content may change as needed for operations.\"]},\"section5\":{\"title\":\"Article 5 (User Obligations)\",\"content\":\"Users must not engage in the following activities:\",\"items\":[\"Activities that interfere with normal service operation\",\"Unauthorized use or misuse of others' information\",\"Unauthorized reproduction or distribution of information obtained through the Service\",\"Unauthorized crawling or scraping of the Service\",\"Other activities that violate applicable laws\"]},\"section6\":{\"title\":\"Article 6 (Intellectual Property)\",\"items\":[\"Content information is provided through the TMDb (The Movie Database) API.\",\"Copyright of YouTube review videos belongs to respective video creators.\",\"Intellectual property rights for the Service's design, logo, and features belong to WhatView.\"]},\"section7\":{\"title\":\"Article 7 (Disclaimer)\",\"items\":[\"The Service does not guarantee the accuracy of content information.\",\"We are not responsible for damages caused by information obtained through the Service.\",\"We are not responsible for issues caused by external links.\",\"We are not responsible for service interruptions due to force majeure.\"]},\"section8\":{\"title\":\"Article 8 (Advertising)\",\"content\":\"The Service may display advertisements on the service screen for operational purposes.\"},\"section9\":{\"title\":\"Article 9 (Changes to Terms)\",\"content\":\"These terms may be changed in accordance with relevant laws or service policies.\"},\"section10\":{\"title\":\"Article 10 (Governing Law and Jurisdiction)\",\"content\":\"These terms are governed by the laws of the Republic of Korea.\"}}},\"now\":\"$undefined\",\"timeZone\":\"Asia/Seoul\",\"children\":[\"$\",\"div\",null,{\"className\":\"font-[family-name:var(--font-inter)]\",\"lang\":\"en\",\"children\":[[\"$\",\"$L12\",null,{}],[\"$\",\"main\",null,{\"className\":\"min-h-screen\",\"children\":[\"$\",\"$L2\",null,{\"parallelRouterKey\":\"children\",\"segmentPath\":[\"children\",\"$0:f:0:1:2:children:0\",\"children\"],\"error\":\"$undefined\",\"errorStyles\":\"$undefined\",\"errorScripts\":\"$undefined\",\"template\":[\"$\",\"$L3\",null,{}],\"templateStyles\":\"$undefined\",\"templateScripts\":\"$undefined\",\"notFound\":\"$undefined\",\"forbidden\":\"$undefined\",\"unauthorized\":\"$undefined\"}]}],[\"$\",\"footer\",null,{\"className\":\"border-t border-gray-800 py-8 text-center text-sm text-gray-500\",\"children\":[[\"$\",\"div\",null,{\"className\":\"mb-4 flex justify-center gap-6\",\"children\":[[\"$\",\"a\",null,{\"href\":\"/en/privacy\",\"className\":\"hover:text-gray-300 transition-colors\",\"children\":\"Privacy Policy\"}],[\"$\",\"a\",null,{\"href\":\"/en/terms\",\"className\":\"hover:text-gray-300 transition-colors\",\"children\":\"Terms of Service\"}]]}],[\"$\",\"div\",null,{\"className\":\"mb-4 flex flex-wrap justify-center gap-x-4 gap-y-1 px-4 text-xs text-gray-600\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"This product uses the\",\" \",[\"$\",\"a\",null,{\"href\":\"https://www.themoviedb.org/\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"hover:text-gray-400\",\"children\":\"TMDB API\"}],\" \",\"but is not endorsed or certified by TMDB.\"]}],[\"$\",\"span\",null,{\"children\":[\"YouTube content provided via\",\" \",[\"$\",\"a\",null,{\"href\":\"https://developers.google.com/youtube\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"hover:text-gray-400\",\"children\":\"YouTube API Services\"}]]}]]}],[\"$\",\"p\",null,{\"children\":\"© 2026 WhatView. All rights reserved.\"}]]}]]}]}]\nf:[[\"$\",\"meta\",\"0\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nd:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"title\",\"1\",{\"children\":\"WhatView - Where to Watch? | OTT Search\"}],[\"$\",\"meta\",\"2\",{\"name\":\"description\",\"content\":\"Find where to watch movies and TV shows across streaming platforms.\"}],[\"$\",\"meta\",\"3\",{\"name\":\"author\",\"content\":\"WhatView\"}],[\"$\",\"meta\",\"4\",{\"name\":\"keywords\",\"content\":\"WhatView,OTT search,streaming search,Netflix,Disney+,Hulu,Amazon Prime,movies,TV shows,where to watch\"}],[\"$\",\"meta\",\"5\",{\"name\":\"creator\",\"content\":\"WhatView\"}],[\"$\",\"meta\",\"6\",{\"name\":\"publisher\",\"content\":\"WhatView\"}],[\"$\",\"meta\",\"7\",{\"name\":\"robots\",\"content\":\"in