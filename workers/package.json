{
  "name": "streamly-api",
  "version": "1.0.0",
  "description": "Streamly API - Cloudflare Workers backend",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 execute streamly-db --local --file=./schema.sql",
    "db:remote": "wrangler d1 execute streamly-db --remote --file=./schema.sql",
    "db:seed": "wrangler d1 execute streamly-db --local --file=./seed.sql",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["cloudflare", "workers", "hono", "streamly"],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "hono": "^4.11.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260123.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.60.0"
  }
}
